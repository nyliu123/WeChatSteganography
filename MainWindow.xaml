<Window x:Class="WeChatSteganography.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeChatSteganography"
        Title="微信隐写工具" Width="800" Height="590" MinWidth="600" MinHeight="450"
        Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" xml:lang="zh-CN"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TerminalTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Page}">
        <Border Height="2" VerticalAlignment="Top" IsHitTestVisible="False" Background="{DynamicResource Accent}" />
        <Grid Margin="22,15,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,13" LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" Padding="10,7" CornerRadius="6" VerticalAlignment="Center" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,14 H 6 V 4 H 11 V 20 H 16 V 9 H 21 V 14 H 28"
                              Stroke="{DynamicResource Accent}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <StackPanel>
                            <TextBlock Text="零宽载体示例" Foreground="{DynamicResource Muted}" FontSize="11" />
                            <TextBlock Text="&lt;0x200C&gt;" FontFamily="{StaticResource Mono}" FontSize="16"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="微信隐写工具" FontSize="27" FontWeight="SemiBold" Margin="0,2,0,1" />
                    <TextBlock Text="将 ASCII 明文藏入零宽字符，或从混合文本中提取。"
                               Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TabControl Grid.Row="1" AutomationProperties.Name="工作模式">
                <TabItem Header="编码" Tag="ENC" AutomationProperties.Name="编码">
                    <Grid Margin="15,12,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Label DockPanel.Dock="Left" x:Name="PlainLabel" Content="明文 (ASCII 32 - 126)"
                                   Target="{Binding ElementName=PlainInput}" />
                            <TextBlock Text="\ 后为混淆消息，\\ 表示一个待编码的反斜杠。"
                                       Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Right"
                                       Margin="8,2,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                        <local:InvisibleTextBox Grid.Row="1" x:Name="PlainInput" Style="{StaticResource TokenEditor}"
                                                PreserveRawInput="True" AutomationProperties.LabeledBy="{Binding ElementName=PlainLabel}" />
                        <StackPanel Grid.Row="2" Style="{StaticResource Actions}">
                            <Button Content="编码" Style="{StaticResource Primary}" Click="Encode" />
                            <Button Content="清空" Margin="8,0,0,0" Click="ClearEncode" />
                            <Button Content="复制编码结果" Margin="8,0,0,0" Click="CopyEncoded" />
                        </StackPanel>
                        <Label Grid.Row="3" x:Name="EncodedLabel" Content="编码结果"
                               Target="{Binding ElementName=EncodedOutput}" />
                        <local:InvisibleTextBox Grid.Row="4" x:Name="EncodedOutput" Style="{StaticResource TokenEditor}"
                                                IsReadOnly="True" AutomationProperties.LabeledBy="{Binding ElementName=EncodedLabel}" />
                        <DockPanel Grid.Row="5">
                            <TextBlock x:Name="EncodeCount" Text="已注入不可见字符：0" Style="{StaticResource Readout}" />
                            <TextBlock x:Name="EncodeMessage" Margin="12,0,0,0" Style="{StaticResource Status}" TextAlignment="Right" />
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="解码" Tag="DEC" AutomationProperties.Name="解码">
                    <Grid Margin="15,12,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Label x:Name="MixedLabel" Content="待检测文本"
                               Target="{Binding ElementName=MixedInput}" />
                        <local:InvisibleTextBox Grid.Row="1" x:Name="MixedInput" Style="{StaticResource TokenEditor}"
                                                AutomationProperties.LabeledBy="{Binding ElementName=MixedLabel}" />
                        <StackPanel Grid.Row="2" Style="{StaticResource Actions}">
                            <Button Content="检测并解码" Style="{StaticResource Primary}" Click="Decode" />
                            <Button Content="清空" Margin="8,0,0,0" Click="ClearDecode" />
                        </StackPanel>
                        <Label Grid.Row="3" x:Name="DecodedLabel" Content="解码明文" Target="{Binding ElementName=DecodedOutput}" />
                        <local:InvisibleTextBox Grid.Row="4" x:Name="DecodedOutput" Style="{StaticResource TokenEditor}"
                                                IsReadOnly="True" AutomationProperties.LabeledBy="{Binding ElementName=DecodedLabel}" />
                        <DockPanel Grid.Row="5">
                            <TextBlock x:Name="DecodeCount" Text="检测到不可见字符：0（有效字符：0）" Style="{StaticResource Readout}" />
                            <TextBlock x:Name="DecodeMessage" Margin="12,0,0,0" Style="{StaticResource Status}" TextAlignment="Right" />
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
